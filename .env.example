# Public URL used for share links, Open Graph previews and secure cookies.
# Set this to the URL you will actually visit.
APP_URL=http://localhost:3000
APP_PORT=3000
# WISHLIST_IMAGE=ghcr.io/joelis10/wishlist:latest

# Optional
# COOKIE_SECURE=true
# ALLOW_REGISTRATION=true
# TZ=Europe/London
# DEFAULT_CURRENCY=GBP
# FX_CRON=0 0 * * *

# Optional eBay official API (direct eBay scraping is blocked by bot protection).
# Create an application keyset at https://developer.ebay.com and use its Client ID/Secret.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE_ID=EBAY_GB

# Background price / stock checks
# SCRAPE_ENABLED=true
# SCRAPE_CRON=0 0 * * *
# SCRAPE_HEADLESS=auto
# SCRAPE_JOBS_HEADLESS=false
# CHROMIUM_PATH=/usr/bin/chromium
# SCRAPE_MAX_PER_RUN=1000
# SCRAPE_DELAY_MS=2500
# SCRAPE_DOMAIN_DELAY_MS=15000

# Web Push. If omitted, VAPID keys are generated once and stored in the database.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
